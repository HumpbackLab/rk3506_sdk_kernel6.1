# Misc strange devices for rockchip

config PCIE_FUNC_RKEP
	tristate "Rockchip PCIe EP function driver"
	depends on PCI
	depends on ARCH_ROCKCHIP
	select PCIE_DW_DMATEST
	help
           Enable this configuration option to enable the host side function
	   driver for Rockchip's EP demo function driver.

config PCIE_FUNC_RKEP_USERPAGES
	bool "EP function driver reserve continuous physical space for user layer"
	depends on PCIE_FUNC_RKEP=y
	help
	  Enable this configuration option to reserve continuous physical space
          for user layer in Rockchip's EP demo function driver.

config ROCKCHIP_FLEXBUS_DSHOT
	tristate "Rockchip Flexbus DShot protocol driver"
	depends on ARCH_ROCKCHIP
	depends on OF
	select MFD_ROCKCHIP_FLEXBUS
	help
	  Select this to drive four DShot outputs through Rockchip Flexbus0.

	  The driver exposes a misc character device. Writing a throttle value
	  sends one DShot frame; ioctls can select the DShot bit rate, telemetry
	  bit and raw 11-bit command value. On boards that wire flexbus0 outputs
	  back to flexbus1 inputs through the ESC signal lines, the misc device
	  decodes bidirectional DShot electrical RPM telemetry and also supports a
	  raw sampled passthrough ioctl for ESC configuration tools such as
	  BLHeliSuite32 and AM32 configurators.
