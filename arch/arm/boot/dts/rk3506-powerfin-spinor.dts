 */

/dts-v1/;

#include "rk3506-powerfin.dts"

/ {
	model = "RK3506G PowerFin SPI NOR";
};

&fspi {
	/delete-node/ flash@0;

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <80000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};
