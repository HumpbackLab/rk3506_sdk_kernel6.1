CONFIG_ROCKCHIP_FLEXBUS_DSHOT=y
CONFIG_IIO_SC7U22=m
CONFIG_AIC_WLAN_SUPPORT=y
CONFIG_AIC_LOADFW_SUPPORT=m
CONFIG_AIC8800_WLAN_SUPPORT=m
# CONFIG_DRM is not set
# CONFIG_BACKLIGHT_CLASS_DEVICE is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
CONFIG_RD_GZIP=y
CONFIG_DEBUG_FS=y
CONFIG_PWM_ROCKCHIP_WAVE_CHAR=y

# The NOR recovery rootfs has no module tree. Keep the USB RNDIS gadget
# available in both the normal system and recovery by building its complete
# configfs stack into the shared kernel.
CONFIG_USB=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_DUAL_ROLE=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_U_ETHER=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_UEVENT=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_CONFIGFS_FS=y

# OpenHarmony standard-system kernel interfaces. Keep these settings on the
# dedicated "oh" branch so the OpenHarmony build can use this configuration
# directly without maintaining a second config fragment.
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_ANDROID_BINDER_IPC=y
# CONFIG_ANDROID_BINDERFS is not set
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_ACCESS_TOKENID=y
CONFIG_BINDER_SENDER_INFO=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
